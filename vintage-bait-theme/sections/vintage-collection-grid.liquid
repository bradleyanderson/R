{%- comment -%}
  Vintage Bait — featured collection grid (e.g. Vintage Apparel / Fishing Merch).
  Each block links to a collection and renders a faded, sun-bleached image
  treatment via .vb-card__media img in assets/vintage-bait.css.
{%- endcomment -%}

<section class="color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="vb-display" style="text-align: center; padding-top: var(--vb-section-gap);">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  <div class="vb-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = collections[block.settings.collection]
      -%}
      <a
        href="{{ collection.url | default: '#' }}"
        class="vb-card"
        {{ block.shopify_attributes }}
      >
        <div class="vb-card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
          {%- elsif block.settings.image -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.heading }}
          {%- else -%}
            <div class="vb-card__media--placeholder">
              {%- render 'icon-fishhook', class: 'vb-icon' -%}
            </div>
          {%- endif -%}
        </div>
        <div class="vb-card__body">
          {%- if block.settings.eyebrow != blank -%}
            <span class="vb-card__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          <h3 class="vb-card__title">{{ block.settings.heading | default: collection.title }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="vb-card__desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Vintage collection grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Collection"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Override title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image (used if collection has no featured image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vintage collection grid",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "eyebrow": "Casual Wear",
            "heading": "Vintage Apparel",
            "description": "Dark florals, gothic motifs, and worn-in silhouettes cut for the romantically inclined."
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "eyebrow": "Accessories",
            "heading": "Vintage Merch",
            "description": "Stickers, koozies, and keepsakes for the darkly sentimental."
          }
        }
      ]
    }
  ]
}
{% endschema %}
