# Vintage Bait — Shopify environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Admin API (used by scripts/bulk_create_products.py) -------------------
# Create a custom app in Shopify Admin: Settings > Apps and sales channels >
# Develop apps. Required scopes: read_products, write_products,
# read_inventory, write_inventory, read_locations, read_collections,
# write_collections.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# --- Theme deploy (Shopify CLI, used by .github/workflows/*) ---------------
# Generate via `shopify theme token` or a custom app with theme access.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Theme IDs for staging vs. production (Online Store > Themes > ... > theme id
# in the URL). These are GitHub repo secrets for CI, listed here for local
# reference only.
STAGING_THEME_ID=
PRODUCTION_THEME_ID=
